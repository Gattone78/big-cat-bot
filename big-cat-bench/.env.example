# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Home Assistant (long-lived access token from a dedicated "robot" user)
HA_URL=https://homeassistant.example.com
HA_TOKEN=

# Media devices (leave blank for platform defaults; run `ffmpeg -list_devices true -f dshow -i dummy`
# on Windows or `ffmpeg -f avfoundation -list_devices true -i ""` on macOS to find names/indices)
AUDIO_DEVICE=
VIDEO_DEVICE=
VIDEO_FPS=1

# Face (web page served by the brain; open it in any browser on the LAN)
FACE_PORT=8787

# Where the bot's voice plays: 'face' (the browser page, default) or 'ffplay'
AUDIO_OUT=face
# Local port ffplay connects to for playback, only used when AUDIO_OUT=ffplay
PLAYER_PORT=24001
