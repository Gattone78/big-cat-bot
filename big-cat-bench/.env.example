# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Home Assistant (long-lived access token from a dedicated "robot" user)
HA_URL=https://homeassistant.example.com
HA_TOKEN=

# Media devices (leave blank for platform defaults; run `ffmpeg -list_devices true -f dshow -i dummy`
# on Windows or `ffmpeg -f avfoundation -list_devices true -i ""` on macOS to find names/indices)
AUDIO_DEVICE=
VIDEO_DEVICE=
VIDEO_FPS=1

# Face (web page served by the brain; open it in any browser on the LAN)
FACE_PORT=8787

# Where the bot's voice plays: 'face' (the browser page, default) or 'ffplay'
AUDIO_OUT=face
# Local port ffplay connects to for playback, only used when AUDIO_OUT=ffplay
PLAYER_PORT=24001

# ---- Local brain (npm run local) --------------------------------------------
# Base URLs of the GPU-VM services (see deploy/). Adjust to however Caddy/UniFi
# exposes them, or use http://<gpu-vm ip>:8000/8001/8002 — nothing is hardcoded.
STT_URL=http://stt.lan
LLM_URL=http://vllm.lan
TTS_URL=http://tts.lan
# Model names as the services know them
STT_MODEL=Systran/faster-whisper-large-v3-turbo
LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# TTS: 'chatterbox' uses /tts (per-request exaggeration); 'openai' uses
# /v1/audio/speech with raw PCM (the kokoro fallback — set TTS_MODEL=kokoro,
# TTS_VOICE=af_heart, TTS_URL to port 8003).
TTS_API=chatterbox
# Voice: a predefined voice shipped with the server (list: GET /v1/audio/voices),
# or with TTS_VOICE_MODE=clone a reference clip filename from deploy/voices/
TTS_VOICE=Emily.wav
TTS_VOICE_MODE=predefined
# Chatterbox expressiveness, 0.25-2.0
TTS_EXAGGERATION=0.5
# Optional per-persona voices, e.g. TTS_VOICE_HAL9000=hal.wav (fallback: TTS_VOICE)
# End-of-utterance: how much silence ends a turn, and Silero speech threshold 0..1
VAD_SILENCE_MS=400
VAD_THRESHOLD=0.5
# How many user/assistant exchanges to keep in the rolling context
HISTORY_TURNS=8
