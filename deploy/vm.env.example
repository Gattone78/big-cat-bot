# Copy to deploy/vm.env (gitignored) for .\deploy\vm.ps1 - never commit vm.env.

# Proxmox web UI/API endpoint
PVE_URL=https://<proxmox-host>:8006
# API token: <user>@<realm>!<tokenid>=<secret uuid from the UI>
PVE_TOKEN=root@pam!bigcat=00000000-0000-0000-0000-000000000000
# Name of the GPU VM as shown in Proxmox
PVE_VM=gpu-vm
