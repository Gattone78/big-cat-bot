# Copy to deploy/.env on the GPU VM. Never commit deploy/.env.

# Hugging Face token — model downloads (vLLM Qwen weights, Chatterbox models).
HF_TOKEN=

# Hugging Face cache for vLLM. Default: a named volume managed by nerdctl.
# If the VM already has a HF cache outside k8s (check: ls ~/.cache/huggingface),
# set the ABSOLUTE path here to reuse it, e.g. /home/youruser/.cache/huggingface
HF_CACHE_DIR=vllm-hf-cache
